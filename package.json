{
  "name": "@heartmon/scomp",
  "version": "0.0.1",
  "description": "tiny rpc with subscribe support for \"streams\"",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "tslint --project tsconfig.json -t codeFrame 'src/**/*.ts' 'test/**/*.ts'",
    "prebuild": "rimraf dist",
    "build": "tsc",
    "start": "rollup -c rollup.config.ts -w",
    "test": "mocha --compilers js:babel-register --recursive test",
    "test.watch": "mocha --watch --compilers js:babel-register --recursive test"
  },
  "keywords": [
    "RPC",
    "ws",
    "uWS"
  ],
  "devDependencies": {
    "@types/chai": "^4.2.17",
    "@types/jest": "^26.0.23",
    "@types/node": "^10.11.0",
    "@types/socket.io-client": "^1.4.36",
    "@types/sprintf-js": "^1.1.2",
    "@types/uuid": "^8.3.0",
    "babel-eslint": "^6.0.2",
    "babel-plugin-transform-decorators-legacy": "^1.3.4",
    "babel-preset-es2015": "^6.6.0",
    "babel-register": "^6.7.2",
    "chai": "^4.3.4",
    "eslint": "^2.6.0",
    "eslint-config-surikat": "^1.1.0",
    "jest": "^23.6.0",
    "jest-config": "^23.6.0",
    "lodash.camelcase": "^4.3.0",
    "mocha": "^2.5.3",
    "prettier": "^1.14.3",
    "reflect-metadata": "^0.1.3",
    "rimraf": "^2.6.2",
    "rollup": "^2.38.5",
    "rollup-plugin-commonjs": "^9.1.8",
    "rollup-plugin-json": "^3.1.0",
    "rollup-plugin-node-resolve": "^3.4.0",
    "rollup-plugin-sourcemaps": "^0.4.2",
    "rollup-plugin-typescript2": "^0.30.0",
    "should": "^8.3.0",
    "ts-jest": "^23.10.5",
    "ts-node": "^7.0.1",
    "tslint": "^5.11.0",
    "tslint-config-prettier": "^1.15.0",
    "tslint-config-standard": "^8.0.1",
    "typedoc": "^0.12.0",
    "typescript": "^3.0.3"
  },
  "peerDependencies": {
    "slf": "^1.0.3"
  },
  "author": "Surikaterna",
  "license": "MIT",
  "dependencies": {
    "bluebird": "^3.5.1",
    "eventemitter2": "^5.0.1",
    "slf": "^1.0.3",
    "socket.io": "^2.1.1",
    "sprintf-js": "^1.1.1",
    "uuid": "^8.3.2"
  },
  "jest": {
    "transform": {
      ".(ts|tsx)": "ts-jest"
    },
    "testEnvironment": "node",
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test/"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    },
    "collectCoverageFrom": [
      "src/*.{js,ts}"
    ]
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
