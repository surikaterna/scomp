{
  "name": "@scompr/client",
  "version": "0.1.0",
  "description": "Client library for the sComPR service composition framework",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/scomp.git",
    "directory": "packages/client"
  },
  "keywords": [
    "scomp",
    "service-composition",
    "microservices",
    "rpc"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "lint": "biome check src/",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@scompr/core": "workspace:*"
  },
  "devDependencies": {
    "@scompr/core": "workspace:*",
    "@scompr/types": "workspace:*"
  }
}
