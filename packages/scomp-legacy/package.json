{
  "name": "@scomp/legacy",
  "version": "0.0.1",
  "description": "tiny rpc with subscribe support for \"streams\"",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "tsc --noEmit -p tsconfig.json",
    "prebuild": "rimraf dist",
    "build": "tsc",
    "start": "rollup -c rollup.config.ts -w",
    "test": "set TS_NODE_COMPILER_OPTIONS={\"module\": \"commonjs\" } && mocha -r ts-node/register test/**/*.spec.ts",
    "test.watch": "mocha --watch -r ts-node/register test/**/*.spec.ts"
  },
  "keywords": [
    "RPC",
    "ws",
    "uWS"
  ],
  "peerDependencies": {
    "slf": "^2.0.3"
  },
  "author": "Surikaterna",
  "license": "MIT",
  "dependencies": {
    "bluebird": "^3.7.2",
    "eventemitter2": "^6.4.9",
    "slf": "^2.0.3",
    "socket.io": "^4.8.3",
    "sprintf-js": "^1.1.3",
    "uuid": "^13.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
