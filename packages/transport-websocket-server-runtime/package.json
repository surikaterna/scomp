{
  "name": "@scompr/transport-websocket-server-runtime",
  "version": "0.0.0",
  "description": "WebSocket server runtime transport for sComPR",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/surikaterna/scomp.git", "directory": "packages/transport-websocket-server-runtime" },
  "keywords": ["scomp", "service-composition", "microservices", "rpc"],
  "engines": { "node": ">=18" },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "lint": "bunx @biomejs/biome check src/",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@scompr/core": "workspace:*",
    "@scompr/transport-shared": "workspace:*"
  },
  "devDependencies": {
    "@scompr/core": "workspace:*",
    "@scompr/transport-shared": "workspace:*",
    "@scompr/types": "workspace:*"
  }
}
