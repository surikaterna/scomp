{
  "name": "@scompr/transport-browser-windows",
  "version": "1.0.0",
  "description": "Browser window messaging transport for sComPR",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surikaterna/scomp.git",
    "directory": "packages/transport-browser-windows"
  },
  "keywords": [
    "scomp",
    "service-composition",
    "microservices",
    "rpc"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./worker-entry": {
      "types": "./dist/worker-entry.d.ts",
      "import": "./dist/worker-entry.mjs",
      "require": "./dist/worker-entry.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "lint": "biome check src/",
    "test": "vitest run",
    "smoke:bundler": "bun ../../check-transport-browser-windows-bundler-smoke.mjs"
  },
  "peerDependencies": {
    "@scompr/core": "workspace:*",
    "@scompr/transport-shared": "workspace:*"
  },
  "devDependencies": {
    "@scompr/core": "workspace:*",
    "@scompr/transport-shared": "workspace:*",
    "@scompr/types": "workspace:*"
  }
}
